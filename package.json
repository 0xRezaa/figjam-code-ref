{
  "name": "figjam-code-ref",
  "version": "0.1.0",
  "private": true,
  "description": "FigJam widget that shows the lines behind a GitHub permalink in an overlay",
  "license": "MIT",
  "author": "Reza Banazadeh",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p widget-src && tsc -p ui-src && tsc -p .",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "highlight.js": "11.12.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.142.0",
    "@figma/widget-typings": "1.13.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
